#ifndef FILEWATCH_VERSION_H
#define FILEWATCH_VERSION_H

#define LIBFILEWATCH_VERSION_MAJOR @LIBFILEWATCH_VERSION_MAJOR@
#define LIBFILEWATCH_VERSION_MINOR @LIBFILEWATCH_VERSION_MINOR@
#define LIBFILEWATCH_VERSION_PATCH @LIBFILEWATCH_VERSION_PATCH@
#define LIBFILEWATCH_VERSION_STRING "@LIBFILEWATCH_VERSION_STRING@"
#define LIBFILEWATCH_COMMIT_COUNT @LIBFILEWATCH_COMMIT_COUNT@

namespace filewatch {

struct Version {
    static int major() noexcept { return @LIBFILEWATCH_VERSION_MAJOR@; }
    static int minor() noexcept { return @LIBFILEWATCH_VERSION_MINOR@; }
    static int patch() noexcept { return @LIBFILEWATCH_VERSION_PATCH@; }
    static const char* string() noexcept { return "@LIBFILEWATCH_VERSION_STRING@"; }
    static int commitCount() noexcept { return @LIBFILEWATCH_COMMIT_COUNT@; }
};

inline const char* getVersionString() noexcept {
    return "@LIBFILEWATCH_VERSION_STRING@";
}

} // namespace filewatch

#endif // FILEWATCH_VERSION_H
