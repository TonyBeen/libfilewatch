#ifndef FILEWATCH_VERSION_H
#define FILEWATCH_VERSION_H

#define LIBFILEWATCH_VERSION_MAJOR 0
#define LIBFILEWATCH_VERSION_MINOR 2
#define LIBFILEWATCH_VERSION_PATCH 5
#define LIBFILEWATCH_VERSION_STRING "0.2.5"

namespace filewatch {

struct Version {
    static int major() noexcept { return 0; }
    static int minor() noexcept { return 2; }
    static int patch() noexcept { return 5; }
    static const char* string() noexcept { return "0.2.5"; }
};

inline const char* getVersionString() noexcept {
    return "0.2.5";
}

} // namespace filewatch

#endif // FILEWATCH_VERSION_H
